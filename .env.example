# ---------------------------------------------------------------------------
# Trade Confirmation API configuration
# Copy this file to .env and adjust as needed.
# ---------------------------------------------------------------------------

# Application metadata
APP_NAME=Trade Confirmation API
APP_VERSION=1.0.0
APP_DESCRIPTION=Generates trade confirmation reports from DuckDB trade data.

# Path to the DuckDB database file (tables: tbl_account, tbl_trade_info).
# Defaults to <project_root>/data/trades_db.duckdb
#TRADE_DB_PATH=

# Base directory where generated PDF reports are saved.
# Each report is written to <REPORT_OUTPUT_DIR>/<trading_date>/Trade_Confirmation_<client_code>.pdf
# Defaults to <project_root>/output/trade_confirmations
#REPORT_OUTPUT_DIR=